{
  "name": "wifi-probescope",
  "version": "2.0.0",
  "description": "Analisador de exposicao de privacidade em probe requests 802.11 (CLI TypeScript/Node.js)",
  "type": "module",
  "bin": {
    "wifi-probescope": "dist/cli.js"
  },
  "scripts": {
